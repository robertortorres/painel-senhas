# Copie para .env e preencha:  cp .env.example .env && chmod 600 .env
# NUNCA commite o .env (já está no .gitignore).
#
# Gere segredos com:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

TZ=America/Sao_Paulo
HTTP_PORT=80

# Banco de dados
# ATENÇÃO: em instalação existente, use as senhas ATUAIS do banco
# (o MySQL só aplica estas variáveis na criação do volume).
DB_NAME=clinicasga
DB_USER=sgaapp
DB_PASS=
MYSQL_ROOT_PASSWORD=

# JWT (mínimo 32 caracteres). Trocar desloga todo mundo.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Senha do usuário "admin", usada só quando o banco não tem nenhum usuário
ADMIN_SENHA_INICIAL=

# Fuso usado pelo banco para NOW()/CURDATE(). Veja o README antes de mudar.
DB_TIMEZONE=-03:00

# Fila: 0 = prioritário sempre antes dos normais; N = 1 prioritário a cada N normais
PRIORIDADE_A_CADA=0

# Limite de senhas por minuto por IP (totem)
LIMITE_SENHAS_MINUTO=30

# Quantos proxies confiáveis existem na frente da API (nginx = 1; NPM + nginx = 2)
TRUST_PROXY=1
